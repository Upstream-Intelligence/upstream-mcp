# Upstream MCP — environment configuration template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Required for key-gated tools (synthesis, playground generation/scoring, live data).
# Get a key at https://data.upstream.cx
UPSTREAM_DATA_API_KEY=

# Optional: override the API base URL. Default is https://api.data.upstream.cx.
# https is required; http is accepted only for localhost development.
# UPSTREAM_DATA_BASE_URL=https://api.data.upstream.cx

# Optional: per-request timeout in milliseconds. Default 30000 (30s).
# UPSTREAM_DATA_TIMEOUT_MS=30000
